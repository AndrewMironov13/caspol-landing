# CASPOL — статический лендинг на виртуальном хостинге Джино (Apache 2.4)
AddDefaultCharset utf-8
Options -Indexes
DirectoryIndex index.html

# --- Только HTTPS + без www ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Джино держит Apache за прокси: %{HTTPS} тут врёт и даёт вечный редирект,
  # правильное условие — заголовок от прокси (код из справки Джино)
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# --- MIME-типы, которых у Apache может не быть ---
<IfModule mod_mime.c>
  AddType image/webp            .webp
  AddType image/avif            .avif
  AddType image/svg+xml         .svg
  AddType video/mp4             .mp4
  AddType font/woff2            .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Сжатие (у Джино включён gzip, brotli нет) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Кэширование ---
<IfModule mod_headers.c>
  # Хэшированные бандлы Vite — можно навсегда
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Картинки, кадры, видео — имена не хэшированы, месяц
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML всегда свежий, иначе клиент увидит старую версию после выкладки
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
